# Copy to .env and fill in. Never commit real secrets.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Datastores (match docker-compose) ---
DATABASE_URL=postgresql+asyncpg://trade:trade@localhost:5432/tradeassist
REDIS_URL=redis://localhost:6379/0

# --- Agent / LLM ---
# Default provider is Claude. Switch to "litellm" to use OpenAI / local Ollama.
AGENT_PROVIDER=claude
# Leave blank to use each provider's default model (e.g. claude-sonnet-4-6).
AGENT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Paper trading ---
PAPER_STARTING_CASH=100000

# --- Durability ---
# Zero-config SQLite file holding the bot's history + your account so they
# survive restarts. Mount this directory as a volume when you deploy.
SQLITE_PATH=./data/trade_assist.db

# --- Auth ---
# Secret used to sign session tokens. MUST be a long random value before you
# share a link with anyone (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
AUTH_SECRET=dev-insecure-change-me

# --- Web ---
CORS_ORIGINS=["http://localhost:3000"]
